rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "alriachybachir11@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.department in ['men', 'women', 'shoes', 'unisex'] &&
             data.category is string && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.isActive is bool;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 50 &&
             data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 300 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidSettings(data) {
      return data.storeName is string && data.storeName.size() <= 100 &&
             data.heroTitle is string && data.heroTitle.size() <= 200 &&
             data.menWhatsAppNumber is string && data.menWhatsAppNumber.size() <= 50 &&
             data.womenWhatsAppNumber is string && data.womenWhatsAppNumber.size() <= 50;
    }

    // 1. Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 2. Orders Collection (Customer writable on creation, Admin only for reading & updating to protect PII)
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin() && isValidId(orderId);
    }

    // 3. Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId) && isValidSettings(request.resource.data);
    }

    // 4. Admin Users Collection
    match /admins/{userId} {
      allow read, write: if isAdmin() && isValidId(userId);
    }
  }
}
